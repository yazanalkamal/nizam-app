# ---- Corpus & derived artifacts ----
# Scraped/raw source files are re-fetchable and license-pending (H1); the parsed,
# provenance-stamped corpus and the golden set ARE tracked and must not be ignored.
data/raw/
data/scratch/
data/cache/
*.pdf.tmp
embeddings_cache/
*.faiss
*.index

# ---- User data / PDPL (must never leave the box) ----
